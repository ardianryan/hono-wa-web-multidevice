# Server Configuration
PORT=4000
NODE_ENV=production
COOKIE_SECURE=false

# Database Configuration (PostgreSQL)
# For Docker/Coolify: Use postgresql://honowa:honowa_secret@postgres:5432/honowa
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/hono_wa

# Detailed DB Config (Alternative)
PGHOST=localhost
PGPORT=5432
PGDATABASE=hono_wa
PGUSER=your_username
PGPASSWORD=your_password
PGPOOL_MAX=10

# Default Admin Account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Webhook (Optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 Configuration (for Webhook Media Upload)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=honowa-elian
R2_REGION=auto
R2_PREFIX=honowa-media
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
